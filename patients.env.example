# Copy to patients.env (gitignored) — same AWS profile as QuickSight / S3 upload
AWS_REGION=us-east-1
AWS_PROFILE=onedatasoftware-customer-poc

# Option A — exact S3 link to your file (recommended; matches QuickSight manifest folder)
PATIENTS_S3_URI=s3://healthcare-datasets-ai/patients/patients_300_records.json

# Option B — list all .json/.csv under prefix (omit PATIENTS_S3_URI if using this)
PATIENTS_BUCKET=healthcare-datasets-ai
PATIENTS_PREFIX=patients/

# Before:  aws sso login --profile onedatasoftware-customer-poc
# Verify:  http://localhost:5000/api/dataset-info?refresh=1   → data_source must be s3 or s3_uri
