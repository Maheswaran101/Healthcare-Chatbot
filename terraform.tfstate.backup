            ],
            "action_group_id": "RNG7OU52R5",
            "action_group_name": "PatientAnalyticsActions",
            "action_group_state": "ENABLED",
            "agent_id": "Q3IT7IQOEX",
            "agent_version": "DRAFT",
            "api_schema": [
              {
                "payload": "{\"info\":{\"title\":\"Healthcare Patient Analytics Actions\",\"version\":\"1.0.0\"},\"openapi\":\"3.0.3\",\"paths\":{\"/getCoverageGapSummary\":{\"post\":{\"description\":\"Return patients and summary metrics where CoverageGap is above a threshold.\",\"operationId\":\"getCoverageGapSummary\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"limit\":{\"default\":10,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"},\"threshold\":{\"default\":0,\"type\":\"number\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Coverage gap rows and metrics\"}}}},\"/getDemographicsBreakdown\":{\"post\":{\"description\":\"Return patient distribution grouped by Gender or Race.\",\"operationId\":\"getDemographicsBreakdown\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"groupBy\":{\"default\":\"Gender\",\"enum\":[\"Gender\",\"Race\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Demographic distribution\"}}}},\"/getHighExpensePatients\":{\"post\":{\"description\":\"Return patients sorted by healthcare expense descending. Use this for high paid, high cost, high expense, expensive, or top patient cost questions.\",\"operationId\":\"getHighExpensePatients\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"limit\":{\"default\":10,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"},\"threshold\":{\"default\":0,\"type\":\"number\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"rows\":{\"items\":{\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"High expense patient rows\"}}}},\"/getHighRiskPatients\":{\"post\":{\"description\":\"Return patients with elevated operational risk using expense, coverage gap, age, and state context.\",\"operationId\":\"getHighRiskPatients\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"limit\":{\"default\":10,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"High-risk patient rows with risk scores\"}}}},\"/getPatientsByState\":{\"post\":{\"description\":\"Return patient records for a specific state, or grouped patient counts by state when no state is supplied.\",\"operationId\":\"getPatientsByState\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"state\":{\"description\":\"Two-letter state code such as MA, NY, CA, or TX. Optional.\",\"type\":\"string\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"State patient summary\"}}}},\"/getTopExpenseStates\":{\"post\":{\"description\":\"Return state-level expense comparisons sorted by total healthcare expense descending.\",\"operationId\":\"getTopExpenseStates\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"limit\":{\"default\":10,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"State expense comparison rows\"}}}},\"/searchPatients\":{\"post\":{\"description\":\"Search patient records by free text and optional filters.\",\"operationId\":\"searchPatients\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"filters\":{\"additionalProperties\":true,\"type\":\"object\"},\"query\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Matching patient rows\"}}}}}}",
                "s3": []
              }
            ],
